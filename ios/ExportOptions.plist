<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  导出选项模板。CI 会用 sed 把 ${TEAM_ID} / ${BUNDLE_ID} 替换成 Secrets 中的真实值。

  为什么 method 是 development：
  免费 Apple ID **无法**创建 Distribution 证书与 Ad Hoc / App Store 描述文件，
  只能用 iOS Development。这带来两个必然结果，请在安装前知悉：
    - 只能装到「已在开发者后台注册过的设备」（免费账号每年最多注册 100 台）
    - 签名 7 天后过期，需重新签名续期（数据不受影响，App 只是打不开）

  若日后升级为付费账号，把 method 改成 app-store 即可，其余流程不变。
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>development</string>

	<key>teamID</key>
	<string>${TEAM_ID}</string>

	<!-- 免费账号只能用通配符 App ID，因此这里必须显式关闭按需分发的 capabilities -->
	<key>provisioningProfiles</key>
	<dict>
		<key>${BUNDLE_ID}</key>
		<string>${BUNDLE_ID} Development</string>
	</dict>

	<key>signingStyle</key>
	<string>manual</string>

	<key>compileBitcode</key>
	<false/>

	<key>stripSwiftSymbols</key>
	<true/>

	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
