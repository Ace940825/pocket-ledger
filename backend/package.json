{
  "name": "pocket-ledger-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Pocket Ledger 云端同步后端：Cloudflare Workers + D1 + R2（永久免费层）",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply pocket_ledger_prod --local",
    "migrate:remote": "wrangler d1 migrations apply pocket_ledger_prod --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  }
}
